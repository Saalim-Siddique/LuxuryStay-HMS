PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/luxurystay?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Password hashing ──────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local development: Vite dev server
# Production: set to your actual frontend URL e.g. https://www.luxurystay.com
CLIENT_ORIGIN=http://localhost:5173

# ── Refresh-token cookie ──────────────────────────────────────────────────────
# Name of the httpOnly cookie that carries the refresh token
REFRESH_TOKEN_COOKIE_NAME=hms_rt

# Secret used to sign the cookie-parser (extra integrity layer)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace_with_32_char_random_hex_string

# Set to "true" in production (requires HTTPS)
COOKIE_SECURE=false

# "Lax" for same-site, "Strict" for tightest security, "None" for cross-origin (requires Secure=true)
COOKIE_SAME_SITE=Lax

# Optional: set to your apex domain in production e.g. .luxurystay.com
# COOKIE_DOMAIN=

# ── Email (optional — used in Phase 6 for notifications) ─────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@luxurystay.com
EMAIL_PASS=your_smtp_password
