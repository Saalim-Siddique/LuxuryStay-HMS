# ==============================================================================
# LuxuryStay HMS — Root Environment Template (Reference Only)
# ==============================================================================
# At runtime, configure separate environment files inside each workspace:
#   - server/.env  (copy from server/.env.example)
#   - client/.env  (copy from client/.env.example)
# Never commit actual .env files or real secrets to Git.
# ==============================================================================

# ── Server Configuration (server/.env) ────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/luxurystay?retryWrites=true&w=majority

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# CORS Allowed Origin(s)
CLIENT_ORIGIN=http://localhost:5173

# Refresh-Token Cookie Configuration
REFRESH_TOKEN_COOKIE_NAME=hms_rt
COOKIE_SECRET=replace_with_32_char_random_hex_string
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# COOKIE_DOMAIN=

# Email / SMTP (optional — Phase 6 notifications)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@luxurystay.com
EMAIL_PASS=your_smtp_password

# ── Client Configuration (client/.env) ────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=LuxuryStay HMS
